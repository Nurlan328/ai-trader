# Copy to .env and fill in what you need.

# --- Claude ---
# Leave empty if you're logged in via `ant auth login`; otherwise put your key here.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (higher = deeper reasoning, more cost per decision)
CLAUDE_EFFORT=medium

# --- Market ---
# Crypto symbols contain "/", e.g. BTC/USDT. Anything else is treated as a stock ticker (AAPL, SPY).
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
EXCHANGE=binance
LOOKBACK_BARS=300

# --- Mode ---
# paper = simulated fills, no real money (default). live = real orders via ccxt.
TRADING_MODE=paper
# Live trading only activates when ALL THREE are set:
LIVE_CONFIRM=
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# --- Portfolio & risk ---
START_CASH=10000
MAX_POSITION_PCT=0.20        # max 20% of equity per position
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.03      # stop opening new positions after -3% on the day
MIN_CONFIDENCE=0.60          # ignore signals below this confidence
MIN_NOTIONAL=10
FEE_PCT=0.001                # 0.1% per side (Binance spot default)
SLIPPAGE_PCT=0.0005
DEFAULT_STOP_LOSS_PCT=0.03
DEFAULT_TAKE_PROFIT_PCT=0.06

STATE_DIR=state
LOOP_INTERVAL_SEC=3600
